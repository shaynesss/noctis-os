# Noctis OS backend — environment variables
# Copy to .env and fill in real values. Never commit .env itself.

# Bearer token required on every backend route (SPEC.md EDD: "Backend auth is mandatory, not optional" —
# localhost binding alone isn't sufficient, CSRF/DNS-rebinding class of attack).
NOCTIS_API_TOKEN=

# Absolute path to the vault root (second-brain/), used for all direct filesystem reads/writes.
# No MCP/Obsidian dependency for the backend itself — see SPEC.md EDD decisions.
VAULT_PATH=/absolute/path/to/second-brain

# Port the FastAPI backend listens on.
PORT=8000

# Optional override for nightshift's distiller model (backend/nightshift/runner.py).
# Defaults to the cheapest/fastest current Claude tier for mechanical lessons-distillation
# work. Bump this when a smaller/newer tier ships, rather than editing code.
NIGHTSHIFT_DISTILLER_MODEL=

# --- frontend (Vite) ---------------------------------------------------
# Vite only exposes variables prefixed VITE_, and it inlines them into the
# built bundle. That is acceptable here only because Noctis is a local
# single-user desktop app whose backend binds to localhost: the token
# authenticates the shell to a server on the same machine, and anyone who
# can read the bundle can already read this file. Do not reuse this pattern
# for anything served to a browser over a network.
VITE_API_BASE=http://localhost:8000
VITE_API_TOKEN=

# --- optional, all with working defaults ------------------------------
# Everything below can be left unset. They are listed because they exist in
# the code and were previously discoverable only by reading it.

# Absolute path to the `claude` binary. Overrides PATH lookup and the usual
# install locations. Needed when Claude Code lives somewhere non-standard, or
# to pin a specific build. (orchestrator/driver.py)
NOCTIS_CLAUDE_BIN=

# Where SQLite conversation history and the search index live.
# Default: backend/data/ (orchestrator/store.py)
NOCTIS_DATA_DIR=

# Explicit path to the history database, for the MCP server specifically —
# it runs as its own process and cannot always infer NOCTIS_DATA_DIR.
# Default: derived from NOCTIS_DATA_DIR. (mcp/server.py)
NOCTIS_HISTORY_DB=

# Where the MCP server reaches the backend. Change only if PORT changed.
# Default: http://127.0.0.1:8000 (mcp/server.py)
NOCTIS_BACKEND=

# Model used to write the one-line recap shown when a conversation is
# restored. Cheap by design — it summarises, it does not reason.
# Default: claude-haiku-4-5 (orchestrator/driver.py)
NOCTIS_RECAP_MODEL=

# Where Plan-stage scratch directories are created before a project is named.
# Exists mainly so tests do not write into a real home directory.
# Default: ~/Developer (routers/mode.py)
NOCTIS_SCRATCH_ROOT=
