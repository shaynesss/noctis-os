<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE. __REPO_ROOT__ is substituted by bootstrap/ at install time.
     Do not launchctl load this file directly - render it first. launchd
     does not expand ~ or environment variables in these paths, which is
     why an absolute path is required and therefore why this is a
     template rather than a checked-in literal. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.noctis-os.nightshift</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/scripts/nightshift_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <!-- Nightly, 03:00 local -- single fixed run, not an interval. Nightshift
         re-derives slack from scratch every run (nightshift.md's Failure
         Behavior), so a missed run just means the next one catches up. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/backend/runtime/nightshift.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/backend/runtime/nightshift.log</string>
</dict>
</plist>
