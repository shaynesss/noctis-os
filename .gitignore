# Secrets
.env

# Python
__pycache__/
*.pyc
backend/.venv/
backend/venv/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Impeccable live-mode runtime journal (local recovery state, not project source)
.impeccable/live/sessions/

# Hook-driven action-feed logs (backend/hooks/log_action.py) -- high-churn,
# ephemeral, explicitly NOT vault content. See SPEC.md EDD "State files".
backend/runtime/*.log

# busy_marker.py's per-mode marker files -- same category as the logs
# above (local runtime state, not project source), just a different
# extension. Added 2026-07-22 when busy tracking moved off state.md.
backend/runtime/*.busy
# The supervisor's one rotated copy of dev.log, and the drafts nightshift
# keeps when a gate drops them (runner.DROPS_DIR).
backend/runtime/*.log.*
backend/runtime/nightshift-drops/

# The project's own hook registration (the telemetry hooks, with this
# machine's absolute paths baked in) -- local machine state, not source.
.claude/settings.local.json

# Editor state, not source. (v1's VS Code launch wrote a resume task here.)
.vscode/tasks.json
.vscode/settings.json

# v1's per-mode config dirs under backend/launch_config/ were ignored here
# until 2026-09-29; the directory went at the 2026-09-12 cutover, and no
# launch sets CLAUDE_CONFIG_DIR, so there is nothing left to ignore.

# OS
.DS_Store

# Tauri build artifacts and generated schemas
frontend/src-tauri/target/
frontend/src-tauri/gen/

# Conversation history and anything else the running backend writes into it.
# These were tracked until 2026-09-09, so every commit shipped a binary diff
# of the transcripts and the history is still in past commits — see
# STATUS.md. The vault is the record for anything worth keeping; this is a
# local cache the app rebuilds.
backend/data/
