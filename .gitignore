# Secrets
.env

# Python
__pycache__/
*.pyc
backend/.venv/
backend/venv/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Impeccable live-mode runtime journal (local recovery state, not project source)
.impeccable/live/sessions/

# Hook-driven action-feed logs (backend/hooks/log_action.py) -- high-churn,
# ephemeral, explicitly NOT vault content. See SPEC.md EDD "State files".
backend/runtime/*.log

# busy_marker.py's per-mode marker files -- same category as the logs
# above (local runtime state, not project source), just a different
# extension. Added 2026-07-22 when busy tracking moved off state.md.
backend/runtime/*.busy

# A Dev-mode launch writes a per-project local hook registration here (see
# launch_surfaces._ensure_dev_hooks) -- local machine state, not source.
.claude/settings.local.json

# Same for the resume-task VS Code writes into on every Dev-mode launch (see
# launch_surfaces._write_resume_task) -- regenerated per launch, not source.
.vscode/tasks.json
.vscode/settings.json

# Claude Code's own runtime state accumulates here once this dir is used as
# CLAUDE_CONFIG_DIR for a non-dev launch (see session.py) -- only CLAUDE.md
# is source, everything else is generated session/cache state.
# Claude Code config dirs are machine state, not source. Ignore all of them
# wholesale rather than enumerating known files: an enumerated list silently
# fails to cover a NEW config dir, and after its one-time login that dir holds
# .claude.json with an oauthAccount -- committable to a public repo. The only
# tracked exception is v1's hand-written nondev/CLAUDE.md, still live until the
# Stage 2 cutover. v2's per-mode CLAUDE.md files are generated by bootstrap and
# rewritten by the orchestrator on every launch, so they are never tracked.
backend/launch_config/*
!backend/launch_config/nondev/
backend/launch_config/nondev/*
!backend/launch_config/nondev/CLAUDE.md

# OS
.DS_Store
